{
  // OBM Solutions — static site deployed as a Worker with static assets.
  // No "main" entry point: there is no server-side code any more, because
  // payments go straight to Payfast's hosted checkout from the payment form.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obm-solutions",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
